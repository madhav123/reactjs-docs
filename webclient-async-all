---

### 2. Backend REST Services (Simulators)

We'll create two simple controllers that return data after a short delay. This delay simulates network latency or processing time.

**`src/main/java/com/example/webclientasyncexample/backend/Service1Controller.java`**

```java
package com.example.webclientasyncexample.backend;

import lombok.AllArgsConstructor;
import lombok.Data;
import lombok.NoArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;
import reactor.core.publisher.Mono;

@RestController
@RequestMapping("/api/service1")
@Slf4j
public class Service1Controller {

    @GetMapping
    public Mono<Service1Response> getService1Data() {
        log.info("Received request for Service 1. Simulating work for 2000ms...");
        // Simulate a blocking operation or delay (for non-reactive backend)
        // For a reactive backend, use Mono.delay or similar non-blocking approach
        try {
            Thread.sleep(2000); // Simulate 2-second delay
        } catch (InterruptedException e) {
            Thread.currentThread().interrupt();
            return Mono.error(e);
        }
        Service1Response response = new Service1Response("Data from Service 1", System.currentTimeMillis());
        log.info("Service 1 finished. Returning: {}", response);
        return Mono.just(response);
    }
}

@Data
@AllArgsConstructor
@NoArgsConstructor
class Service1Response {
    private String message;
    private long timestamp;
}
```

**`src/main/java/com/example/webclientasyncexample/backend/Service2Controller.java`**

```java
package com.example.webclientasyncexample.backend;

import lombok.AllArgsConstructor;
import lombok.Data;
import lombok.NoArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;
import reactor.core.publisher.Mono;

@RestController
@RequestMapping("/api/service2")
@Slf4j
public class Service2Controller {

    @GetMapping
    public Mono<Service2Response> getService2Data() {
        log.info("Received request for Service 2. Simulating work for 1500ms...");
        try {
            Thread.sleep(1500); // Simulate 1.5-second delay
        } catch (InterruptedException e) {
            Thread.currentThread().interrupt();
            return Mono.error(e);
        }
        Service2Response response = new Service2Response("Data from Service 2", "Important detail");
        log.info("Service 2 finished. Returning: {}", response);
        return Mono.just(response);
    }
}

@Data
@AllArgsConstructor
@NoArgsConstructor
class Service2Response {
    private String info;
    private String detail;
}
```

**Note on `Thread.sleep`:** In a *real* reactive application, you'd avoid `Thread.sleep` in controller methods as it blocks the thread. Here, we use it to *simulate* a slow external (potentially blocking) API for the purpose of demonstrating `WebClient`'s async capabilities on the client side. If these backend services were truly reactive, they might use `Mono.delay()` instead of `Thread.sleep()`.

---

### 3. WebClient Configuration

Define a `WebClient` bean with a base URL.

**`src/main/java/com/example/webclientasyncexample/client/WebClientConfig.java`**

```java
package com.example.webclientasyncexample.client;

import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;
import org.springframework.web.reactive.function.client.WebClient;

@Configuration
public class WebClientConfig {

    @Bean
    public WebClient webClient(WebClient.Builder builder) {
        // Assuming both services are running on the same local server as the client for simplicity
        // If services are separate, use their respective base URLs.
        return builder.baseUrl("http://localhost:8080")
                .build();
    }
}
```

---

### 4. Client Application - Making Async Calls

This is the core part. We'll use `WebClient` to make two `Mono` calls and then combine them using `Mono.zip()`.

**`src/main/java/com/example/webclientasyncexample/client/ExternalServiceCaller.java`**

```java
package com.example.webclientasyncexample.client;

import com.example.webclientasyncexample.backend.Service1Response;
import com.example.webclientasyncexample.backend.Service2Response;
import lombok.AllArgsConstructor;
import lombok.Data;
import lombok.NoArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.stereotype.Service;
import org.springframework.web.reactive.function.client.WebClient;
import reactor.core.publisher.Mono;

@Service
@Slf4j
public class ExternalServiceCaller {

    private final WebClient webClient;

    public ExternalServiceCaller(WebClient webClient) {
        this.webClient = webClient;
    }

    public Mono<CombinedResponse> callServicesInAsync() {
        long startTime = System.currentTimeMillis();
        log.info("Client started calling external services...");

        // 1. Define the first asynchronous call
        Mono<Service1Response> service1Mono = webClient.get()
                .uri("/api/service1")
                .retrieve()
                .bodyToMono(Service1Response.class)
                .doOnSuccess(res -> log.info("Service 1 call completed: {}", res.getMessage()))
                .doOnError(e -> log.error("Error calling Service 1: {}", e.getMessage()));

        // 2. Define the second asynchronous call
        Mono<Service2Response> service2Mono = webClient.get()
                .uri("/api/service2")
                .retrieve()
                .bodyToMono(Service2Response.class)
                .doOnSuccess(res -> log.info("Service 2 call completed: {}", res.getInfo()))
                .doOnError(e -> log.error("Error calling Service 2: {}", e.getMessage()));

        // 3. Combine the results of both Monos concurrently
        // Mono.zip subscribes to all source Monos concurrently and emits a Tuple2 (or a custom type if a combiner is provided)
        // when all sources complete.
        return Mono.zip(service1Mono, service2Mono,
                (service1Res, service2Res) -> new CombinedResponse(
                        service1Res.getMessage(),
                        service1Res.getTimestamp(),
                        service2Res.getInfo(),
                        service2Res.getDetail(),
                        System.currentTimeMillis() - startTime
                ))
                .doOnSuccess(combinedResponse -> log.info("All services completed in {} ms. Combined result: {}",
                        combinedResponse.getElapsedTimeMillis(), combinedResponse))
                .doOnError(e -> log.error("One or more service calls failed: {}", e.getMessage()));
    }
}

// DTOs for the responses (lombok for brevity)
@Data
@AllArgsConstructor
@NoArgsConstructor
class CombinedResponse {
    private String service1Message;
    private long service1Timestamp;
    private String service2Info;
    private String service2Detail;
    private long elapsedTimeMillis;
}
