### The Redux Store Example (`redux-example.js`)

```javascript
// 1. Import createStore from Redux
// In a modern React app, you'd typically use `@reduxjs/toolkit`
// and import `configureStore` instead, but for a raw Redux example,
// `createStore` is what you'd use from the core library.
const { createStore } = require('redux');

// --- 2. Define Action Types (Constants for better maintainability) ---
const INCREMENT = 'INCREMENT';
const DECREMENT = 'DECREMENT';
const RESET = 'RESET';
const SET_VALUE = 'SET_VALUE'; // Action to set a specific value

// --- 3. Define Action Creators (Functions that return action objects) ---
// Action creators make it easier to dispatch actions consistently.
const increment = () => ({
    type: INCREMENT
});

const decrement = () => ({
    type: DECREMENT
});

const reset = () => ({
    type: RESET
});

const setValue = (value) => ({
    type: SET_VALUE,
    payload: value // Actions often carry data, conventionally in a 'payload' property
});

// --- 4. Define the Initial State ---
const initialState = {
    count: 0,
    message: 'Welcome to Redux Counter!'
};

// --- 5. Define the Reducer Function ---
// A reducer is a pure function that takes the current state and an action,
// and returns a *new* state. It must never mutate the original state directly.
const counterReducer = (state = initialState, action) => {
    switch (action.type) {
        case INCREMENT:
            // Return a new state object, spreading the old state and updating 'count'
            return {
                ...state,
                count: state.count + 1
            };
        case DECREMENT:
            return {
                ...state,
                count: state.count - 1
            };
        case RESET:
            return {
                ...state,
                count: 0
            };
        case SET_VALUE:
            return {
                ...state,
                count: action.payload // Use the payload from the action
            };
        default:
            // If the action type is not recognized, return the current state unchanged
            return state;
    }
};

// --- 6. Create the Redux Store ---
// The store holds the complete state tree of your app.
// It's the only place where the state resides.
const store = createStore(counterReducer);

// --- 7. Subscribe to State Changes ---
// `store.subscribe()` allows you to register a callback function that will be
// called whenever an action has been dispatched and the state tree has changed.
// It returns an unsubscribe function.
const unsubscribe = store.subscribe(() => {
    console.log("State changed! Current State:", store.getState());
});

// --- 8. Interact with the Store (Dispatch Actions) ---
console.log("--- Initial State ---");
console.log(store.getState()); // Get the current state

console.log("\n--- Dispatching Actions ---");

// Dispatch an 'INCREMENT' action using its action creator
store.dispatch(increment()); // count: 1

// Dispatch another 'INCREMENT' action
store.dispatch(increment()); // count: 2

// Dispatch a 'DECREMENT' action
store.dispatch(decrement()); // count: 1

// Dispatch a 'SET_VALUE' action with a payload
store.dispatch(setValue(100)); // count: 100

// Dispatch a 'RESET' action
store.dispatch(reset()); // count: 0

// Dispatch one more 'INCREMENT'
store.dispatch(increment()); // count: 1

console.log("\n--- Final State ---");
console.log(store.getState());

// --- 9. Unsubscribe (Optional, but good practice for cleanup) ---
// If you no longer need to listen for state changes, call the unsubscribe function.
unsubscribe();
console.log("\n(Unsubscribed from state changes)");

// Dispatching an action after unsubscribing.
// The state will still update, but our `store.subscribe` callback won't log it.
store.dispatch(increment());
console.log("State after unsubscribe (not logged by subscriber):", store.getState());
```

